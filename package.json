{
	"name": "kibra",
	"version": "1.0.4",
	"description": "The high-performance component registry for Expo and React Native.",
	"type": "module",
	"main": "./dist/index.js",
	"bin": {
		"kibra": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc -w",
		"test": "vitest run",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"build-registry": "node dist/registry-builder.js --input registry --output dist-registry",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"react-native",
		"expo",
		"tailwind",
		"nativewind",
		"ui",
		"components",
		"registry"
	],
	"author": "Antigravity <antigravity@kibra.dev>",
	"license": "MIT",
	"dependencies": {
		"@inquirer/prompts": "^7.1.0",
		"chalk": "^5.3.0",
		"commander": "^12.0.0",
		"fs-extra": "^11.2.0",
		"fast-glob": "^3.3.2",
		"ora": "^8.0.1",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.11.24",
		"typescript": "^5.3.3",
		"vitest": "^1.3.1",
		"@biomejs/biome": "^1.5.3"
	}
}
