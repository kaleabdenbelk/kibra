{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"moduleDetection": "force",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"typeRoots": ["./node_modules/@types"]
	},
	"exclude": [
		"node_modules",
		"dist",
		"test",
		"lib",
		"components",
		"try",
		"noin",
		"noins",
		"test-*",
		"e2e-*",
		"docs",
		"registry",
		"scripts",
		"templates"
	]
}
